{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/stamp-build.js",
  "redirects": [
    {
      "source": "/((?!assets/).+)",
      "has": [
        {
          "type": "host",
          "value": "mpstandings.sgj.luxe"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/preview",
      "destination": "/preview/",
      "permanent": false
    },
    {
      "source": "/review",
      "destination": "/review/",
      "permanent": false
    }
  ]
}
